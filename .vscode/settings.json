{
  "python.defaultInterpreterPath": "${workspaceFolder}/assignment1-basics/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}/assignment1-basics"
